{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker/project name in the Cloudflare dashboard.
  "name": "leaguecup",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "leaguecup"
    }
  ],
  "observability": { "enabled": true },
  // Non-secret config only. SUPABASE_SERVICE_ROLE_KEY must be added in the
  // dashboard as type "Secret" (Settings → Variables and Secrets) — never here,
  // since this file is committed to git.
  "vars": {
    "SUPABASE_URL": "https://zzcwkhransxdgeiqrrtf.supabase.co"
  }
}
