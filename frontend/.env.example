# Supabase (Project Settings → API Keys). Salin ke .env.local untuk development.
# Tanpa ini, development lokal memakai file data/db.json.
# Di Cloudflare, isi keduanya di Settings → Variables & Secrets.
SUPABASE_URL=
# RAHASIA: service role / secret key. Hanya dipakai di server, jangan diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
