    "migrate": "node --env-file-if-exists=.env.local scripts/migrate-to-supabase.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.7",
    "wrangler": "^4.144.0"
  }
}
